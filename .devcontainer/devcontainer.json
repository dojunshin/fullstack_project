{
  "name": "dojun_project_app",
  "dockerComposeFile": [
    "docker-compose.devcontainer.yml"
  ],
  "service": "workspace",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "forwardPorts": [3000, 4000, 3306],
  "postCreateCommand": "apk add --no-cache git && npm install && cd client && npm install && cd ../server && npm install",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
