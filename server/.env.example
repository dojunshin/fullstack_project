PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# 아래 두 값은 다나와 Open API 문서에 맞게 채우세요.
DANAWA_API_BASE_URL=https://openapi.danawa.com
DANAWA_SEARCH_PATH=/v1/search
DANAWA_API_KEY=replace-with-your-real-api-key

# DB 설정 (mysql 또는 oracle)
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpass
DB_NAME=test
DB_POOL_SIZE=10

# Oracle일 때 사용합니다. 예: 127.0.0.1:1521/XEPDB1
DB_CONNECT_STRING=127.0.0.1:1521/XEPDB1
